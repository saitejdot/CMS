# CMS v2 — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git. NEVER put real values in this file.

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=

# ── Authentication ────────────────────────────────────────────────────────────
# Admin login password (single-admin system)
ADMIN_PASSWORD=

# JWT signing secret — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Rate Limiting (Upstash Redis) ─────────────────────────────────────────────
# Required: serverless-compatible distributed rate limiting
# Create a free database at https://console.upstash.com
# Copy from the "REST API" section of your database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email (Nodemailer / SMTP) ─────────────────────────────────────────────────
# Gmail address used to send subscriber notifications
EMAIL_USER=
# Gmail app password (not your login password)
# Generate at: Google Account → Security → App Passwords
EMAIL_PASS=

# ── Public URL ────────────────────────────────────────────────────────────────
# Full base URL of the deployed site (no trailing slash)
# Used for email links and CSRF origin validation
# Example: https://tejwrites.vercel.app
NEXT_PUBLIC_BASE_URL=

# ── Phase 1B+ (not required yet) ─────────────────────────────────────────────
# Cloudflare Images / Stream (required for media CDN — Phase 1B)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Email service API key (if migrating from Nodemailer to Resend — Phase 1B)
# RESEND_API_KEY=

# AI provider (required for Ask Tej / Translation — Phase 4)
# AI_PROVIDER_API_KEY=
